# Конфиденциальные данные
wp-config.php
.env

# Загрузки и медиа (обычно слишком тяжёлые для git)
wp-content/uploads/

# Кэш и временные файлы плагинов
wp-content/cache/
wp-content/upgrade/
wp-content/upgrade-temp-backup/
wp-content/backup*/
wp-content/backups/
wp-content/wflogs/
wp-content/ai1wm-backups/

# Логи
*.log
wp-content/debug.log
error_log

# Плагины кэширования/бэкапа с локальными данными
wp-content/plugins/wp-rocket/cache/
wp-content/plugins/*/cache/

# Системные и IDE-файлы
.DS_Store
Thumbs.db
.vscode/
.idea/

# Зависимости (если используете composer/npm для сборки)
node_modules/
vendor/

# Local by Flywheel / другие локальные окружения
.local-*
local-*.yml

# Файлы Apache, которые не нужны на nginx
.htaccess