#, php-format
msgid "Go to SureRank ⇾ <a href=\"%s\">Search Console</a>"
msgstr "Ga naar SureRank ⇾ <a href=\"%s\">Search Console</a>"

#: inc/api/analyzer.php:569
msgid "Sign in with your Google account"
msgstr "Log in met uw Google-account"

#: inc/api/analyzer.php:570
msgid "Select your site and complete the connection"
msgstr "Selecteer uw site en voltooi de verbinding"

#: inc/api/analyzer.php:585
msgid "Once connected, SureRank will start using Search Console data to show search performance and indexing insights."
msgstr "Zodra u verbonden bent, begint SureRank Search Console-gegevens te gebruiken om zoekprestaties en indexeringsinzichten weer te geven."

