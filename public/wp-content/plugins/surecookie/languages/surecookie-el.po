msgstr "%1$d ανιχνεύτηκαν από τον σαρωτή, %2$d προσαρμοσμένοι"

#: build/admin.js:78
msgid "New Resource"
msgstr "Νέος πόρος"

#: build/admin.js:78
msgid "All your scripts will be displayed here"
msgstr "Όλα τα σενάρια σας θα εμφανιστούν εδώ"

#: build/admin.js:78
msgid "Run a scan to detect third-party resources, or add a script manually."
msgstr "Εκτελέστε σάρωση για να ανιχνεύσετε πόρους τρίτων ή προσθέστε ένα σενάριο χειροκίνητα."

#: build/admin.js:78
msgid "Add New Resource"
msgstr "Προσθήκη νέου πόρου"

#: build/admin.js:78
msgid "Unlock Custom Script Rules & Whitelisting"
msgstr "Ξεκλείδωμα προσαρμοσμένων κανόνων σεναρίων & λίστας επιτρεπόμενων"

#: build/admin.js:78
msgid "Add your own scripts to block under any category, whitelist trusted scripts, and manage it all from one place."
msgstr "Προσθέστε τα δικά σας σενάρια για αποκλεισμό σε οποιαδήποτε κατηγορία, καταχωρήστε αξιόπιστα σενάρια στη λίστα επιτρεπόμενων και διαχειριστείτε τα όλα από ένα μέρος."

#: build/admin.js:78
msgid "Generate your cookie policy automatically from your settings, or display it anywhere using a shortcode."
msgstr "Δημιουργήστε αυτόματα την πολιτική cookie από τις ρυθμίσεις σας ή εμφανίστε την οπουδήποτε χρησιμοποιώντας ένα shortcode."

#: build/admin.js:78
msgid "Automatically re-scan your site and get notified when new cookies or trackers appear."
msgstr "Αυτόματη επανέλεγχος του ιστότοπού σας και ειδοποίηση όταν εμφανίζονται νέα cookies ή ιχνηλάτες."

#: build/admin.js:84
msgid "Show your cookie banner only in regions where consent is required."
msgstr "Εμφάνιση της μπάντας cookie μόνο σε περιοχές όπου απαιτείται συγκατάθεση."

#: build/admin.js:84
msgid "Share visitor consent across your sites so users don’t need to give consent again."
msgstr "Κοινή χρήση της συγκατάθεσης επισκεπτών σε όλους τους ιστότοπούς σας ώστε οι χρήστες να μην χρειάζεται να δώσουν ξανά συγκατάθεση."

#: build/admin.js:84
msgid "Unlock Consent Sharing"
msgstr "Ξεκλείδωμα Κοινής Χρήσης Συγκατάθεσης"

#: build/admin.js:77
msgid "Allowed to load while Google Consent Mode is active, instead of being blocked before consent."
msgstr "Επιτρέπεται η φόρτωση ενώ είναι ενεργή η Λειτουργία Συγκατάθεσης Google, αντί να αποκλείεται πριν από τη συγκατάθεση."

#: build/admin.js:77
msgid "These Google services are allowed to load while Google Consent Mode is active, instead of being blocked before consent. For Google tag products, Consent Mode then controls what they may store and which identifiers they may use. It does not stop them from contacting Google. They cannot be removed here."
msgstr "Αυτές οι υπηρεσίες της Google επιτρέπεται να φορτώνονται ενώ είναι ενεργή η Λειτουργία Συγκατάθεσης Google, αντί να αποκλείονται πριν από τη συγκατάθεση. Για τα προϊόντα ετικετών της Google, η Λειτουργία Συγκατάθεσης ελέγχει τι μπορούν να αποθηκεύσουν και ποιοι αναγνωριστικοί μπορούν να χρησιμοποιήσουν. Δεν εμποδίζει την επικοινωνία τους με την Google. Δεν μπορούν να αφαιρεθούν εδώ."
