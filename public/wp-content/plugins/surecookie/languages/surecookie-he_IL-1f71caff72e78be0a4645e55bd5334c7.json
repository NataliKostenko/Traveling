u05e8 \u05e9\u05dc\u05da. \u05de\u05d2\u05d1\u05dc\u05d5\u05ea \u05d4\u05ea\u05d5\u05db\u05e0\u05d9\u05ea \u05d4\u05de\u05dc\u05d0\u05d5\u05ea \u05e9\u05dc\u05da \u05d9\u05e4\u05ea\u05d7\u05d5 \u05d0\u05d5\u05d8\u05d5\u05de\u05d8\u05d9\u05ea \u05dc\u05d0\u05d7\u05e8 \u05de\u05db\u05df."],"The free plan supports scanning up to %d pages. Upgrade now to scan more pages and keep your cookie list updated automatically.":["\u05d4\u05ea\u05d5\u05db\u05e0\u05d9\u05ea \u05d4\u05d7\u05d9\u05e0\u05de\u05d9\u05ea \u05ea\u05d5\u05de\u05db\u05ea \u05d1\u05e1\u05e8\u05d9\u05e7\u05d4 \u05e9\u05dc \u05e2\u05d3 %d \u05d3\u05e4\u05d9\u05dd. \u05e9\u05d3\u05e8\u05d2 \u05e2\u05db\u05e9\u05d9\u05d5 \u05db\u05d3\u05d9 \u05dc\u05e1\u05e8\u05d5\u05e7 \u05d9\u05d5\u05ea\u05e8 \u05d3\u05e4\u05d9\u05dd \u05d5\u05dc\u05e9\u05de\u05d5\u05e8 \u05e2\u05dc \u05e8\u05e9\u05d9\u05de\u05ea \u05d4\u05e2\u05d5\u05d2\u05d9\u05d5\u05ea \u05e9\u05dc\u05da \u05de\u05e2\u05d5\u05d3\u05db\u05e0\u05ea \u05d0\u05d5\u05d8\u05d5\u05de\u05d8\u05d9\u05ea."],"Let's help you discover cookies, configure consent choices, and improve how your website handles visitor privacy. SureCookie automatically detects and categorizes cookies so you can stay focused on growing your business.":["\u05d1\u05d5\u05d0 \u05e0\u05e2\u05d6\u05d5\u05e8 \u05dc\u05da \u05dc\u05d2\u05dc\u05d5\u05ea \u05e2\u05d5\u05d2\u05d9\u05d5\u05ea, \u05dc\u05d4\u05d2\u05d3\u05d9\u05e8 \u05d1\u05d7\u05d9\u05e8\u05d5\u05ea \u05d4\u05e1\u05db\u05de\u05d4 \u05d5\u05dc\u05e9\u05e4\u05e8 \u05d0\u05ea \u05d4\u05d0\u05d5\u05e4\u05df \u05e9\u05d1\u05d5 \u05d4\u05d0\u05ea\u05e8 \u05e9\u05dc\u05da \u05de\u05d8\u05e4\u05dc \u05d1\u05e4\u05e8\u05d8\u05d9\u05d5\u05ea \u05d4\u05de\u05d1\u05e7\u05e8\u05d9\u05dd. SureCookie \u05de\u05d6\u05d4\u05d4 \u05d5\u05de\u05e1\u05d5\u05d5\u05d2 \u05e2\u05d5\u05d2\u05d9\u05d5\u05ea \u05d0\u05d5\u05d8\u05d5\u05de\u05d8\u05d9\u05ea \u05db\u05d3\u05d9 \u05e9\u05ea\u05d5\u05db\u05dc \u05dc\u05d4\u05d9\u05e9\u05d0\u05e8 \u05de\u05de\u05d5\u05e7\u05d3 \u05d1\u05e6\u05de\u05d9\u05d7\u05ea \u05d4\u05e2\u05e1\u05e7 \u05e9\u05dc\u05da."],"Keep consent records locally on the site and export individual records when needed":["\u05e9\u05de\u05d5\u05e8 \u05e8\u05e9\u05d5\u05de\u05d5\u05ea \u05d4\u05e1\u05db\u05de\u05d4 \u05de\u05e7\u05d5\u05de\u05d9\u05ea \u05d1\u05d0\u05ea\u05e8 \u05d5\u05d9\u05d9\u05e6\u05d0 \u05e8\u05e9\u05d5\u05de\u05d5\u05ea \u05d1\u05d5\u05d3\u05d3\u05d5\u05ea \u05d1\u05e2\u05ea \u05d4\u05e6\u05d5\u05e8\u05da"],"Select %s":["\u05d1\u05d7\u05e8 %s"],"Category for %s":["\u05e7\u05d8\u05d2\u05d5\u05e8\u05d9\u05d4 \u05e2\u05d1\u05d5\u05e8 %s"],"Select category":["\u05d1\u05d7\u05e8 \u05e7\u05d8\u05d2\u05d5\u05e8\u05d9\u05d4"],"%1$s %2$s":["%1$s %2$s"],"Scan from Your Browser (Best for this site)":["\u05e1\u05e8\u05d9\u05e7\u05d4 \u05de\u05d3\u05e4\u05d3\u05e4\u05df \u05e9\u05dc\u05da (\u05d4\u05d8\u05d5\u05d1\u05d4 \u05d1\u05d9\u05d5\u05ea\u05e8 \u05dc\u05d0\u05ea\u05e8 \u05d6\u05d4)"],"Scan from Your Browser":["\u05e1\u05e8\u05d9\u05e7\u05d4 \u05de\u05d3\u05e4\u05d3\u05e4\u05df \u05e9\u05dc\u05da"],"Our scanner couldn't fully access your site due to server restrictions. This method runs the scan directly in your browser, ensuring accurate detection without being blocked.":["\u05d4\u05e1\u05d5\u05e8\u05e7 \u05e9\u05dc\u05e0\u05d5 \u05dc\u05d0 \u05d4\u05e6\u05dc\u05d9\u05d7 \u05dc\u05d2\u05e9\u05ea \u05d1\u05de\u05dc\u05d5\u05d0\u05d5 \u05dc\u05d0\u05ea\u05e8 \u05e9\u05dc\u05da \u05e2\u05e7\u05d1 \u05d4\u05d2\u05d1\u05dc\u05d5\u05ea \u05e9\u05e8\u05ea. \u05e9\u05d9\u05d8\u05d4 \u05d6\u05d5 \u05de\u05e8\u05d9\u05e6\u05d4 \u05d0\u05ea \u05d4\u05e1\u05e8\u05d9\u05e7\u05d4 \u05d9\u05e9\u05d9\u05e8\u05d5\u05ea \u05d1\u05d3\u05e4\u05d3\u05e4\u05df \u05e9\u05dc\u05da, \u05d5\u05de\u05d1\u05d8\u05d9\u05d7\u05d4 \u05d2\u05d9\u05dc\u05d5\u05d9 \u05de\u05d3\u05d5\u05d9\u05e7 \u05dc\u05dc\u05d0 \u05d7\u05e1\u05d9\u05de\u05d5\u05ea."],"Run the scan directly in your browser. This helps detect cookies, scripts, and embeds even when external scanners are blocked.":["\u05d4\u05e8\u05e5 \u05d0\u05ea \u05d4\u05e1\u05e8\u05d9\u05e7\u05d4 \u05d9\u05e9\u05d9\u05e8\u05d5\u05ea \u05d1\u05d3\u05e4\u05d3\u05e4\u05df \u05e9\u05dc\u05da. \u05d6\u05d4 \u05e2\u05d5\u05d6\u05e8 \u05dc\u05d6\u05d4\u05d5\u05ea \u05e2\u05d5\u05d2\u05d9\u05d5\u05ea, \u05e1\u05e7\u05e8\u05d9\u05e4\u05d8\u05d9\u05dd \u05d5\u05d4\u05d8\u05de\u05e2\u05d5\u05ea \u05d2\u05dd \u05db\u05d0\u05e9\u05e8 \u05e1\u05d5\u05e8\u05e7\u05d9\u05dd \u05d7\u05d9\u05e6\u05d5\u05e0\u05d9\u05d9\u05dd \u05d7\u05e1\u05d5\u05de\u05d9\u05dd."],"Detects cookies, scripts, and embeds as your visitors would see them.":["\u05de\u05d6\u05d4\u05d4 \u05e2\u05d5\u05d2\u05d9\u05d5\u05ea, \u05e1\u05e7\u05e8\u05d9\u05e4\u05d8\u05d9\u05dd \u05d5\u05d4\u05d8\u05de\u05e2\u05d5\u05ea \u05db\u05e4\u05d9 \u05e9\u05d4\u05de\u05d1\u05e7\u05e8\u05d9\u05dd \u05e9\u05dc\u05da \u05d9\u05e8\u05d0\u05d5 \u05d0\u05d5\u05ea\u05dd."],"Works even when hosting or firewall blocks external scans.":["\u05e4\u05d5\u05e2\u05dc \u05d2\u05dd \u05db\u05d0\u05e9\u05e8 \u05d0\u05d9\u05e8\u05d5\u05d7 \u05d0\u05d5 \u05d7\u05d5\u05de\u05ea \u05d0\u05e9 \u05d7\u05d5\u05e1\u05de\u05d9\u05dd \u05e1\u05e8\u05d9\u05e7\u05d5\u05ea \u05d7\u05d9\u05e6\u05d5\u05e0\u05d9\u05d5\u05ea."],"Results appear automatically in your Tracking Manager.":["\u05d4\u05ea\u05d5\u05e6\u05d0\u05d5\u05ea \u05de\u05d5\u05e4\u05d9\u05e2\u05d5\u05ea \u05d0\u05d5\u05d8\u05d5\u05de\u05d8\u05d9\u05ea \u05d1\u05de\u05e0\u05d4\u05dc \u05d4\u05de\u05e2\u05e7\u05d1 \u05e9\u05dc\u05da."],"Some advanced detections may still require a remote scan when available.":["\u05d7\u05dc\u05e7 \u05de\u05d4\u05d2\u05d9\u05dc\u05d5\u05d9\u05d9\u05dd \u05de\u05ea\u05e7\u05d3\u05de\u05d9\u05dd \u05e2\u05e9\u05d5\u05d9\u05d9\u05dd \u05e2\u05d3\u05d9\u05d9\u05df \u05dc\u05d3\u05e8\u05d5\u05e9 \u05e1\u05e8\u05d9\u05e7\u05d4 \u05de\u05e8\u05d7\u05d5\u05e7 \u05db\u05d0\u05e9\u05e8 \u05d6\u05de\u05d9\u05e0\u05d4."],"How this works":["\u05db\u05d9\u05e6\u05d3 \u05d6\u05d4 \u05e2\u05d5\u05d1\u05d3"],"Before You Start":["\u05dc\u05e4\u05e0\u05d9 \u05e9\u05d0\u05ea\u05d4 \u05de\u05ea\u05d7\u05d9\u05dc"],"To measure cookie duration accurately, this scan temporarily clears cookies for your site in this browser (including your consent choice). Your WordPress login session is preserved, so you'll remain signed in.":["\u05db\u05d3\u05d9 \u05dc\u05de\u05d3\u05d5\u05d3 \u05d1\u05de\u05d3\u05d5\u05d9\u05e7 \u05d0\u05ea \u05de\u05e9\u05da \u05d4\u05e2\u05d5\u05d2\u05d9\u05d4, \u05e1\u05e8\u05d9\u05e7\u05d4 \u05d6\u05d5 \u05de\u05e0\u05e7\u05d4 \u05d6\u05de\u05e0\u05d9\u05ea \u05e2\u05d5\u05d2\u05d9\u05d5\u05ea \u05e2\u05d1\u05d5\u05e8 \u05d4\u05d0\u05ea\u05e8 \u05e9\u05dc\u05da \u05d1\u05d3\u05e4\u05d3\u05e4\u05df \u05d6\u05d4 (\u05db\u05d5\u05dc\u05dc \u05d1\u05d7\u05d9\u05e8\u05ea \u05d4\u05d4\u05e1\u05db\u05de\u05d4 \u05e9\u05dc\u05da). \u05e1\u05e9\u05df \u05d4\u05d4\u05ea\u05d7\u05d1\u05e8\u05d5\u05ea \u05e9\u05dc\u05da \u05dc-WordPress \u05e0\u05e9\u05de\u05e8, \u05db\u05da \u05e9\u05ea\u05d9\u05e9\u05d0\u05e8 \u05de\u05d7\u05d5\u05d1\u05e8."],"An assisted scan visits up to %d pages. Remove some pages to continue.":["\u05e1\u05e8\u05d9\u05e7\u05d4 \u05de\u05e1\u05d9\u05d9\u05e2\u05ea \u05de\u05d1\u05e7\u05e8\u05ea \u05e2\u05d3 %d \u05e2\u05de\u05d5\u05d3\u05d9\u05dd. \u05d4\u05e1\u05e8 \u05db\u05de\u05d4 \u05e2\u05de\u05d5\u05d3\u05d9\u05dd \u05db\u05d3\u05d9 \u05dc\u05d4\u05de\u05e9\u05d9\u05da."],"Scanning in your browser\u2026":["\u05e1\u05e8\u05d9\u05e7\u05d4 \u05d1\u05d3\u05e4\u05d3\u05e4\u05df \u05e9\u05dc\u05da\u2026"],"Start Browser Scan":["\u05d4\u05ea\u05d7\u05dc \u05e1\u05e8\u05d9\u05e7\u05ea \u05d3\u05e4\u05d3\u05e4\u05df"],"A new tab opens to scan your selected pages - keep it active until it finishes.":["\u05db\u05e8\u05d8\u05d9\u05e1\u05d9\u05d9\u05d4 \u05d7\u05d3\u05e9\u05d4 \u05e0\u05e4\u05ea\u05d7\u05ea \u05dc\u05e1\u05e8\u05d9\u05e7\u05ea \u05d4\u05e2\u05de\u05d5\u05d3\u05d9\u05dd \u05e9\u05d1\u05d7\u05e8\u05ea - \u05d4\u05e9\u05d0\u05e8 \u05d0\u05d5\u05ea\u05d4 \u05e4\u05e2\u05d9\u05dc\u05d4 \u05e2\u05d3 \u05dc\u05e1\u05d9\u05d5\u05dd."],"Switch Back":["\u05d7\u05d6\u05d5\u05e8"],"Could not start the assisted scan.":["\u05dc\u05d0 \u05e0\u05d9\u05ea\u05df \u05d4\u05d9\u05d4 \u05dc\u05d4\u05ea\u05d7\u05d9\u05dc \u05d0\u05ea \u05d4\u05e1\u05e8\u05d9\u05e7\u05d4 \u05d4\u05de\u05e1\u05d9\u05d9\u05e2\u05ea."],"Could not start the assisted scan":["\u05dc\u05d0 \u05e0\u05d9\u05ea\u05df \u05d4\u05d9\u05d4 \u05dc\u05d4\u05ea\u05d7\u05d9\u05dc \u05d0\u05ea \u05d4\u05e1\u05e8\u05d9\u05e7\u05d4 \u05d4\u05de\u05e1\u05d9\u05d9\u05e2\u05ea"],"Please try again in a moment.":["\u05e0\u05e1\u05d4 \u05e9\u05d5\u05d1 \u05d1\u05e2\u05d5\u05d3 \u05e8\u05d2\u05e2."],"Your browser blocked the scan window":["\u05d4\u05d3\u05e4\u05d3\u05e4\u05df \u05e9\u05dc\u05da \u05d7\u05e1\u05dd \u05d0\u05ea \u05d7\u05dc\u05d5\u05df \u05d4\u05e1\u05e8\u05d9\u05e7\u05d4"],"Allow pop-ups for this site, then start the scan again.":["\u05d0\u05e4\u05e9\u05e8 \u05d7\u05dc\u05d5\u05e0\u05d5\u05ea \u05e7\u05d5\u05e4\u05e6\u05d9\u05dd \u05dc\u05d0\u05ea\u05e8 \u05d6\u05d4, \u05d5\u05d0\u05d6 \u05d4\u05ea\u05d7\u05dc \u05d0\u05ea \u05d4\u05e1\u05e8\u05d9\u05e7\u05d4 \u05e9\u05d5\u05d1."],"Scan Queued for Later":["\u05d4\u05e1\u05e8\u05d9\u05e7\u05d4 \u05d4\u05d5\u05e2\u05de\u05d3\u05d4 \u05d1\u05ea\u05d5\u05e8 \u05dc\u05de\u05d5\u05e2\u05d3 \u05de\u05d0\u05d5\u05d7\u05e8 \u05d9\u05d5\u05ea\u05e8"],"Today's page budget is used up, so the remaining pages will scan automatically once it resets. Any cookies already found are saved. To scan sooner, run it again with fewer pages.":["\u05ea\u05e7\u05e6\u05d9\u05d1 \u05d4\u05e2\u05de\u05d5\u05d3\u05d9\u05dd \u05e9\u05dc \u05d4\u05d9\u05d5\u05dd \u05e0\u05d5\u05e6\u05dc, \u05dc\u05db\u05df \u05d4\u05e2\u05de\u05d5\u05d3\u05d9\u05dd \u05d4\u05e0\u05d5\u05ea\u05e8\u05d9\u05dd \u05d9\u05e1\u05e8\u05e7\u05d5 \u05d0\u05d5\u05d8\u05d5\u05de\u05d8\u05d9\u05ea \u05dc\u05d0\u05d7\u05e8 \u05d4\u05d0\u05d9\u05e4\u05d5\u05e1. \u05db\u05dc \u05d4\u05e2\u05d5\u05d2\u05d9\u05d5\u05ea \u05e9\u05e0\u05de\u05e6\u05d0\u05d5 \u05db\u05d1\u05e8 \u05e0\u05e9\u05de\u05e8\u05d5. \u05db\u05d3\u05d9 \u05dc\u05e1\u05e8\u05d5\u05e7 \u05de\u05d5\u05e7\u05d3\u05dd \u05d9\u05d5\u05ea\u05e8, \u05d4\u05e4\u05e2\u05dc \u05e9\u05d5\u05d1 \u05e2\u05dd \u05e4\u05d7\u05d5\u05ea \u05e2\u05de\u05d5\u05d3\u05d9\u05dd."],"Scan Couldn't Be Completed":["\u05dc\u05d0 \u05e0\u05d9\u05ea\u05df \u05d4\u05d9\u05d4 \u05dc\u05d4\u05e9\u05dc\u05d9\u05dd \u05d0\u05ea \u05d4\u05e1\u05e8\u05d9\u05e7\u05d4"],"A page may have taken too long to respond. Any cookies already found have been saved, and results add up across scans - nothing is lost. Please try again, scanning fewer pages at a time for a more reliable run.":["\u05d9\u05d9\u05ea\u05db\u05df \u05e9\u05e2\u05de\u05d5\u05d3 \u05dc\u05e7\u05d7 \u05d9\u05d5\u05ea\u05e8 \u05de\u05d3\u05d9 \u05d6\u05de\u05df \u05dc\u05d4\u05d2\u05d9\u05d1. \u05db\u05dc \u05d4\u05e2\u05d5\u05d2\u05d9\u05d5\u05ea \u05e9\u05e0\u05de\u05e6\u05d0\u05d5 \u05db\u05d1\u05e8 \u05e0\u05e9\u05de\u05e8\u05d5, \u05d5\u05d4\u05ea\u05d5\u05e6\u05d0\u05d5\u05ea \u05de\u05e6\u05d8\u05d1\u05e8\u05d5\u05ea \u05d1\u05d9\u05df \u05e1\u05e8\u05d9\u05e7\u05d5\u05ea - \u05dc\u05d0 \u05d0\u05d5\u05d1\u05d3 \u05d3\u05d1\u05e8. \u05d0\u05e0\u05d0 \u05e0\u05e1\u05d4 \u05e9\u05d5\u05d1, \u05e1\u05d5\u05e8\u05e7 \u05e4\u05d7\u05d5\u05ea \u05e2\u05de\u05d5\u05d3\u05d9\u05dd \u05d1\u05db\u05dc \u05e4\u05e2\u05dd \u05dc\u05d4\u05e8\u05e6\u05d4 \u05d0\u05de\u05d9\u05e0\u05d4 \u05d9\u05d5\u05ea\u05e8."]}}}