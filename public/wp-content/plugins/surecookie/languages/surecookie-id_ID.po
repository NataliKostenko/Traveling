#. translators: %d: number of GCM-managed services.
#: build/admin.js:77
#, js-format
msgid "Managed by Google Consent Mode (%d)"
msgstr "Dikelola oleh Google Consent Mode (%d)"

#: build/admin.js:77
msgid "View services"
msgstr "Lihat layanan"

#: build/admin.js:77
msgid "Managed by Google Consent Mode"
msgstr "Dikelola oleh Google Consent Mode"

#: build/admin.js:77
msgid "Auto-whitelisted"
msgstr "Otomatis didaftarkan"

#: build/admin.js:77
msgid "Enter the script domain or host."
msgstr "Masukkan domain atau host skrip."

#: build/admin.js:77
msgid "Select a category."
msgstr "Pilih kategori."

#: build/admin.js:77
msgid "A rule for this script already exists."
msgstr "Aturan untuk skrip ini sudah ada."

#: build/admin.js:77
msgid "Control how scripts and embeds load based on user consent - block them until allowed or mark essential ones to always run."
msgstr "Kontrol bagaimana skrip dan sematan dimuat berdasarkan persetujuan pengguna - blokir sampai diizinkan atau tandai yang penting agar selalu berjalan."

#: build/admin.js:77
msgid "Behavior: Always Allowed"
msgstr "Perilaku: Selalu Diizinkan"

#: build/admin.js:77
msgid "Choose scripts and domains that should never be blocked, so tools like reCAPTCHA and other essential integrations keep working. Google Consent Mode scripts are whitelisted automatically when it is enabled."
msgstr "Pilih skrip dan domain yang tidak boleh diblokir, sehingga alat seperti reCAPTCHA dan integrasi penting lainnya tetap berfungsi. Skrip Google Consent Mode secara otomatis didaftarkan saat diaktifkan."

#: build/admin.js:77
msgid "Block Scripts and Embeds Until Consent Switch"
msgstr "Sakelar Blokir Skrip dan Sematan Sampai Persetujuan"

#: build/admin.js:77
msgid "Block Scripts Until Consent"
msgstr "Blokir Skrip Sampai Persetujuan"

#: build/admin.js:77
msgid "Prevent non-essential scripts and embeds from loading until users give consent."
msgstr "Cegah skrip dan sematan yang tidak penting dimuat sampai pengguna memberikan persetujuan."

#: build/admin.js:77
msgid "Detected and Managed Resources"
msgstr "Sumber Daya yang Terdeteksi dan Dikelola"

#. translators: 1: scanner-detected count, 2: custom rule count
#: build/admin.js:78
#, js-format
msgid "%1$d detected by scanner, %2$d custom"
msgstr "%1$d terdeteksi oleh pemindai, %2$d kustom"

#: build/admin.js:78
msgid "New Resource"
msgstr "Sumber Daya Baru"

#: build/admin.js:78
msgid "All your scripts will be displayed here"
msgstr "Semua skrip Anda akan ditampilkan di sini"

#: build/admin.js:78
msgid "Run a scan to detect third-party resources, or add a script manually."
msgstr "Jalankan pemindaian untuk mendeteksi sumber daya pihak ketiga, atau tambahkan skrip secara manual."

#: build/admin.js:78
msgid "Add New Resource"
msgstr "Tambahkan Sumber Daya Baru"

#: build/admin.js:78
msgid "Unlock Custom Script Rules & Whitelisting"
msgstr "Buka Kunci Aturan Skrip Kustom & Daftar Putih"

#: build/admin.js:78
msgid "Add your own scripts to block under any category, whitelist trusted scripts, and manage it all from one place."
msgstr "Tambahkan skrip Anda sendiri untuk diblokir di bawah kategori apa pun, daftarkan skrip tepercaya, dan kelola semuanya dari satu tempat."

#: build/admin.js:78
msgid "Generate your cookie policy automatically from your settings, or display it anywhere using a shortcode."
msgstr "Hasilkan kebijakan cookie Anda secara otomatis dari pengaturan Anda, atau tampilkan di mana saja menggunakan shortcode."

#: build/admin.js:78
msgid "Automatically re-scan your site and get notified when new cookies or trackers appear."
msgstr "Secara otomatis pindai ulang situs Anda dan dapatkan pemberitahuan saat cookie atau pelacak baru muncul."

#: build/admin.js:84
msgid "Show your cookie banner only in regions where consent is required."
msgstr "Tampilkan banner cookie Anda hanya di wilayah di mana persetujuan diperlukan."

#: build/admin.js:84
msgid "Share visitor consent across your sites so users don’t need to give consent again."
msgstr "Bagikan persetujuan pengunjung di seluruh situs Anda sehingga pengguna tidak perlu memberikan persetujuan lagi."

#: build/admin.js:84
msgid "Unlock Consent Sharing"
msgstr "Buka Kunci Berbagi Persetujuan"

#: build/admin.js:77
msgid "Allowed to load while Google Consent Mode is active, instead of being blocked before consent."
msgstr "Diizinkan untuk dimuat saat Mode Persetujuan Google aktif, alih-alih diblokir sebelum persetujuan."

#: build/admin.js:77
msgid "These Google services are allowed to load while Google Consent Mode is active, instead of being blocked before consent. For Google tag products, Consent Mode then controls what they may store and which identifiers they may use. It does not stop them from contacting Google. They cannot be removed here."
msgstr "Layanan Google ini diizinkan untuk dimuat saat Mode Persetujuan Google aktif, alih-alih diblokir sebelum persetujuan. Untuk produk tag Google, Mode Persetujuan kemudian mengontrol apa yang dapat mereka simpan dan pengenal mana yang dapat mereka gunakan. Ini tidak menghentikan mereka untuk menghubungi Google. Mereka tidak dapat dihapus di sini."
