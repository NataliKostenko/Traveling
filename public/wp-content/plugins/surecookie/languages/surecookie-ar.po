msgstr "قاعدة لهذا السكريبت موجودة بالفعل."

#: build/admin.js:77
msgid "Control how scripts and embeds load based on user consent - block them until allowed or mark essential ones to always run."
msgstr "تحكم في كيفية تحميل السكريبتات والتضمينات بناءً على موافقة المستخدم - حظرها حتى يُسمح بها أو وسم الضرورية منها لتعمل دائمًا."

#: build/admin.js:77
msgid "Behavior: Always Allowed"
msgstr "السلوك: مسموح دائمًا"

#: build/admin.js:77
msgid "Choose scripts and domains that should never be blocked, so tools like reCAPTCHA and other essential integrations keep working. Google Consent Mode scripts are whitelisted automatically when it is enabled."
msgstr "اختر السكريبتات والنطاقات التي يجب ألا تُحظر أبدًا، حتى تستمر أدوات مثل reCAPTCHA والتكاملات الأساسية الأخرى في العمل. تُدرج سكريبتات وضع موافقة Google تلقائيًا في القائمة البيضاء عند تفعيلها."

#: build/admin.js:77
msgid "Block Scripts and Embeds Until Consent Switch"
msgstr "مفتاح حظر السكريبتات والتضمينات حتى الموافقة"

#: build/admin.js:77
msgid "Block Scripts Until Consent"
msgstr "حظر السكريبتات حتى الموافقة"

#: build/admin.js:77
msgid "Prevent non-essential scripts and embeds from loading until users give consent."
msgstr "منع تحميل السكريبتات والتضمينات غير الأساسية حتى يمنح المستخدمون الموافقة."

#: build/admin.js:77
msgid "Detected and Managed Resources"
msgstr "الموارد المكتشفة والمدارة"

#. translators: 1: scanner-detected count, 2: custom rule count
#: build/admin.js:78
#, js-format
msgid "%1$d detected by scanner, %2$d custom"
msgstr "%1$d تم اكتشافه بواسطة الماسح، %2$d مخصص"

#: build/admin.js:78
msgid "New Resource"
msgstr "مورد جديد"

#: build/admin.js:78
msgid "All your scripts will be displayed here"
msgstr "سيتم عرض جميع البرامج النصية الخاصة بك هنا"

#: build/admin.js:78
msgid "Run a scan to detect third-party resources, or add a script manually."
msgstr "قم بتشغيل فحص لاكتشاف الموارد الخارجية، أو أضف برنامجًا نصيًا يدويًا."

#: build/admin.js:78
msgid "Add New Resource"
msgstr "إضافة مورد جديد"

#: build/admin.js:78
msgid "Unlock Custom Script Rules & Whitelisting"
msgstr "فتح قواعد البرامج النصية المخصصة والقائمة البيضاء"

#: build/admin.js:78
msgid "Add your own scripts to block under any category, whitelist trusted scripts, and manage it all from one place."
msgstr "أضف برامجك النصية الخاصة للحظر تحت أي فئة، وأدرج البرامج النصية الموثوقة في القائمة البيضاء، وقم بإدارتها كلها من مكان واحد."

#: build/admin.js:78
msgid "Generate your cookie policy automatically from your settings, or display it anywhere using a shortcode."
msgstr "قم بإنشاء سياسة ملفات تعريف الارتباط تلقائيًا من إعداداتك، أو عرضها في أي مكان باستخدام رمز قصير."

#: build/admin.js:78
msgid "Automatically re-scan your site and get notified when new cookies or trackers appear."
msgstr "أعد فحص موقعك تلقائيًا وتلقى إشعارات عند ظهور ملفات تعريف ارتباط أو متتبعات جديدة."

#: build/admin.js:84
msgid "Show your cookie banner only in regions where consent is required."
msgstr "اعرض لافتة ملفات تعريف الارتباط الخاصة بك فقط في المناطق التي يتطلب فيها الحصول على الموافقة."

#: build/admin.js:84
msgid "Share visitor consent across your sites so users don’t need to give consent again."
msgstr "شارك موافقة الزائر عبر مواقعك حتى لا يحتاج المستخدمون إلى تقديم الموافقة مرة أخرى."

#: build/admin.js:84
msgid "Unlock Consent Sharing"
msgstr "فتح مشاركة الموافقة"

#: build/admin.js:77
msgid "Allowed to load while Google Consent Mode is active, instead of being blocked before consent."
msgstr "مسموح بالتحميل أثناء تفعيل وضع موافقة Google، بدلاً من الحظر قبل الموافقة."

#: build/admin.js:77
msgid "These Google services are allowed to load while Google Consent Mode is active, instead of being blocked before consent. For Google tag products, Consent Mode then controls what they may store and which identifiers they may use. It does not stop them from contacting Google. They cannot be removed here."
msgstr "يُسمح لهذه الخدمات من Google بالتحميل أثناء تفعيل وضع موافقة Google، بدلاً من الحظر قبل الموافقة. بالنسبة لمنتجات علامات Google، يتحكم وضع الموافقة فيما يمكنهم تخزينه وأي معرفات يمكنهم استخدامها. لا يمنعهم من الاتصال بـ Google. لا يمكن إزالتها هنا."
