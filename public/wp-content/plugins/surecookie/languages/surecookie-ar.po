#: build/admin.js:77
msgid "View services"
msgstr "عرض الخدمات"

#: build/admin.js:77
msgid "Managed by Google Consent Mode"
msgstr "تدار بواسطة وضع موافقة Google"

#: build/admin.js:77
msgid "Auto-whitelisted"
msgstr "مُدرج تلقائيًا في القائمة البيضاء"

#: build/admin.js:77
