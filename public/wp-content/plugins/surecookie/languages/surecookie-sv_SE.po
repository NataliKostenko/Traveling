msgstr "Hanteras av Google Consent Mode (%d)"

#: build/admin.js:77
msgid "View services"
msgstr "Visa tjänster"

#: build/admin.js:77
msgid "Managed by Google Consent Mode"
msgstr "Hanteras av Google Consent Mode"

#: build/admin.js:77
msgid "Auto-whitelisted"
msgstr "Automatiskt vitlistad"

#: build/admin.js:77
msgid "Enter the script domain or host."
msgstr "Ange skriptets domän eller värd."

#: build/admin.js:77
msgid "Select a category."
msgstr "Välj en kategori."

#: build/admin.js:77
msgid "A rule for this script already exists."
msgstr "En regel för detta skript finns redan."

#: build/admin.js:77
msgid "Control how scripts and embeds load based on user consent - block them until allowed or mark essential ones to always run."
msgstr "Kontrollera hur skript och inbäddningar laddas baserat på användarsamtycke – blockera dem tills de tillåts eller markera viktiga som alltid ska köras."

#: build/admin.js:77
msgid "Behavior: Always Allowed"
msgstr "Beteende: Alltid tillåtet"

#: build/admin.js:77
msgid "Choose scripts and domains that should never be blocked, so tools like reCAPTCHA and other essential integrations keep working. Google Consent Mode scripts are whitelisted automatically when it is enabled."
msgstr "Välj skript och domäner som aldrig ska blockeras, så att verktyg som reCAPTCHA och andra viktiga integrationer fortsätter fungera. Google Consent Mode-skript vitlistas automatiskt när det är aktiverat."

#: build/admin.js:77
