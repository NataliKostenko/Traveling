0639\u0644\u0649 \u0627\u0644\u0645\u0646\u0637\u0642\u0629\u060c \u062a\u0633\u0627\u0639\u062f\u0643 SureCookie \u0639\u0644\u0649 \u0627\u0644\u0627\u0644\u062a\u0632\u0627\u0645 \u0628\u0627\u0644\u0642\u0648\u0627\u0646\u064a\u0646 \u0645\u0639 \u0628\u0646\u0627\u0621 \u062b\u0642\u0629 \u0627\u0644\u0632\u0648\u0627\u0631."],"Here's what SureCookie will do for you now:":["\u0625\u0644\u064a\u0643 \u0645\u0627 \u0633\u062a\u0641\u0639\u0644\u0647 SureCookie \u0645\u0646 \u0623\u062c\u0644\u0643 \u0627\u0644\u0622\u0646:"],"SureCookie Features":["\u0645\u064a\u0632\u0627\u062a SureCookie"],"Exit Setup":["\u062e\u0631\u0648\u062c \u0645\u0646 \u0627\u0644\u0625\u0639\u062f\u0627\u062f"],"Received":["\u062a\u0645 \u0627\u0644\u0627\u0633\u062a\u0644\u0627\u0645"],"Shared":["\u062a\u0645\u062a \u0627\u0644\u0645\u0634\u0627\u0631\u0643\u0629"],"New":["\u062c\u062f\u064a\u062f"],"SureCookie agent will visit them like real users to detect all cookies in use. Allowed %d pages per scan due to resource constraints.":["\u0633\u064a\u0632\u0648\u0631\u0647\u0645 \u0648\u0643\u064a\u0644 SureCookie \u0645\u062b\u0644 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645\u064a\u0646 \u0627\u0644\u062d\u0642\u064a\u0642\u064a\u064a\u0646 \u0644\u0627\u0643\u062a\u0634\u0627\u0641 \u062c\u0645\u064a\u0639 \u0645\u0644\u0641\u0627\u062a \u062a\u0639\u0631\u064a\u0641 \u0627\u0644\u0627\u0631\u062a\u0628\u0627\u0637 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645\u0629. \u0645\u0633\u0645\u0648\u062d %d \u0635\u0641\u062d\u0627\u062a \u0644\u0643\u0644 \u0641\u062d\u0635 \u0628\u0633\u0628\u0628 \u0642\u064a\u0648\u062f \u0627\u0644\u0645\u0648\u0627\u0631\u062f."],"<p>By scanning you accept our <a>terms and conditions<\/a>.<\/p>":["<p>\u0628\u0627\u0644\u0645\u0633\u062d\u060c \u0623\u0646\u062a \u062a\u0648\u0627\u0641\u0642 \u0639\u0644\u0649 <a>\u0627\u0644\u0634\u0631\u0648\u0637 \u0648\u0627\u0644\u0623\u062d\u0643\u0627\u0645<\/a> \u0627\u0644\u062e\u0627\u0635\u0629 \u0628