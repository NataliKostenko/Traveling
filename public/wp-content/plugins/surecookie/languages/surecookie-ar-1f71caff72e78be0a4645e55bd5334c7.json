43\u0646\u0643 \u0627\u0644\u0642\u064a\u0627\u0645 \u0628\u0647:"],"List of capabilities":["\u0642\u0627\u0626\u0645\u0629 \u0627\u0644\u0642\u062f\u0631\u0627\u062a"],"Connected to SureCookie":["\u0645\u062a\u0635\u0644 \u0628\u0640 SureCookie"],"Back":["\u0639\u0648\u062f\u0629"],"Next":["\u0627\u0644\u062a\u0627\u0644\u064a"],"Skip":["\u062a\u062e\u0637\u064a"],"Connecting\u2026":["\u062c\u0627\u0631\u064d \u0627\u0644\u0627\u062a\u0635\u0627\u0644\u2026"],"Connect":["\u0627\u062a\u0635\u0627\u0644"],"Run a Quick Privacy Scan":["\u062a\u0634\u063a\u064a\u0644 \u0641\u062d\u0635 \u062e\u0635\u0648\u0635\u064a\u0629 \u0633\u0631\u064a\u0639"],"SureCookie will scan your website, detect all cookies, and categorize them automatically.<br\/> This helps you stay compliant without spending hours identifying scripts manually.":["\u0633\u064a\u0642\u0648\u0645 SureCookie \u0628\u0641\u062d\u0635 \u0645\u0648\u0642\u0639\u0643\u060c \u0648\u0627\u0643\u062a\u0634\u0627\u0641 \u062c\u0645\u064a\u0639 \u0645\u0644\u0641\u0627\u062a \u062a\u0639\u0631\u064a\u0641 \u0627\u0644\u0627\u0631\u062a\u0628\u0627\u0637\u060c \u0648\u062a\u0635\u0646\u064a\u0641\u0647\u0627 \u062a\u0644\u0642\u0627\u0626\u064a\u064b\u0627.<br\/> \u0647\u0630\u0627 \u064a\u0633\u0627\u0639\u062f\u0643 \u0639\u0644\u0649 \u0627\u0644\u0628\u0642\u0627\u0621 \u0645\u062a\u0648\u0627\u0641\u0642\u064b\u0627 \u062f\u0648\u0646 \u0642\u0636\u0627\u0621 \u0633\u0627\u0639\u0627\u062a \u0641\u064a \u062a\u062d\u062f\u064a\u062f \u0627\u0644\u0628\u0631\u0627\u0645\u062c \u0627\u0644\u0646\u0635\u064a\u0629 \u064a\u062f\u0648\u064a\u064b\u0627."],"Account not connected":["\u0627\u0644\u062d\u0633\u0627\u0628 \u063a\u064a\u0631 \u0645\u062a\u0635\u0644"],"Please <a>go back<\/a> and connect your SureCookie account to enable cookie scanning.":["\u064a\u0631\u062c\u0649 <a>\u0627\u0644\u0639\u0648\u062f\u0629<\/a> \u0648\u0631\u0628\u0637 \u062d\u0633\u0627\u0628 SureCookie \u0627\u0644\u062e\u0627\u0635 \u0628\u0