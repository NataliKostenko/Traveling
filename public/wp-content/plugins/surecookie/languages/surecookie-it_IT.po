#: build/admin.js:76
msgid "If a resource sets cookies, allowing it directly can be a GDPR violation - only whitelist resources you are sure about."
msgstr "Se una risorsa imposta cookie, consentirla direttamente può violare il GDPR - inserisci in whitelist solo risorse di cui sei sicuro."

#: build/admin.js:76
msgid "Detected by the scanner, so the value cannot be edited."
msgstr "Rilevato dallo scanner, quindi il valore non può essere modificato."

#: build/admin.js:76
msgid "e.g. Support chat"
msgstr "es. Chat di supporto"

#: build/admin.js:76
msgid "Domain / Host"
msgstr "Dominio / Host"

#: build/admin.js:76
msgid "e.g. connect.facebook.net"
msgstr "es. connect.facebook.net"

#: build/admin.js:76
msgid "The host the resource loads from. Pasting a full tag or URL also works."
msgstr "L'host da cui la risorsa viene caricata. Funziona anche incollare un tag o URL completo."

#: build/admin.js:76
msgid "Path / Pattern (advanced)"
msgstr "Percorso / Modello (avanzato)"

#: build/admin.js:76
msgid "e.g. /fbevents.js"
msgstr "es. /fbevents.js"

#: build/admin.js:76
msgid "Optional: narrow the rule to resources that also contain this path, so only one file on the host is blocked."
msgstr "Opzionale: restringi la regola alle risorse che contengono anche questo percorso, così viene bloccato un solo file sull'host."

#: build/admin.js:76
msgid "Script Keywords"
msgstr "Parole chiave dello script"

#: build/admin.js:76
msgid "e.g. fbq, fbq.push"
msgstr "es. fbq, fbq.push"

#: build/admin.js:76
msgid "JavaScript function names to block that depend on the main script (comma separated)."
msgstr "Nomi di funzioni JavaScript da bloccare che dipendono dallo script principale (separati da virgola)."

#: build/admin.js:76
msgid "Script Location"
msgstr "Posizione dello script"

#: build/admin.js:76
msgid "Anywhere"
msgstr "Ovunque"

#: build/admin.js:76
msgid "Where the script loads on the page. SureCookie only looks for it in this section."
msgstr "Dove lo script viene caricato nella pagina. SureCookie lo cerca solo in questa sezione."

#: build/admin.js:76
msgid "This resource stays blocked until the visitor consents to this category."
msgstr "Questa risorsa rimane bloccata finché il visitatore non acconsente a questa categoria."

#: build/admin.js:76
msgid "Unlock Whitelisting"
msgstr "Sblocca whitelist"

#: build/admin.js:76
msgid "Whitelist your own scripts and common services so essential integrations keep working before consent."
msgstr "Inserisci in whitelist i tuoi script e servizi comuni così le integrazioni essenziali funzionano prima del consenso."

#. translators: %d: number of GCM-managed services.
#: build/admin.js:77
#, js-format
msgid "Managed by Google Consent Mode (%d)"
msgstr "Gestito da Google Consent Mode (%d)"

#: build/admin.js:77
msgid "View services"
msgstr "Visualizza servizi"

#: build/admin.js:77
msgid "Managed by Google Consent Mode"
msgstr "Gestito da Google Consent Mode"

#: build/admin.js:77
msgid "Auto-whitelisted"
msgstr "Inserito automaticamente in whitelist"

#: build/admin.js:77
msgid "Enter the script domain or host."
msgstr "Inserisci il dominio o host dello script."

#: build/admin.js:77
msgid "Select a category."
msgstr "Seleziona una categoria."

#: build/admin.js:77
msgid "A rule for this script already exists."
msgstr "Esiste già una regola per questo script."

#: build/admin.js:77
msgid "Control how scripts and embeds load based on user consent - block them until allowed or mark essential ones to always run."
msgstr "Controlla come caricare script e incorporamenti in base al consenso dell'utente - bloccali finché non sono consentiti o segna quelli essenziali per farli sempre eseguire."

#: build/admin.js:77
msgid "Behavior: Always Allowed"
msgstr "Comportamento: Sempre consentito"

#: build/admin.js:77
msgid "Choose scripts and domains that should never be blocked, so tools like reCAPTCHA and other essential integrations keep working. Google Consent Mode scripts are whitelisted automatically when it is enabled."
msgstr "Scegli script e domini che non devono mai essere bloccati, così strumenti come reCAPTCHA e altre integrazioni essenziali continuano a funzionare. Gli script di Google Consent Mode sono inseriti automaticamente in whitelist quando è attivato."

#: build/admin.js:77
msgid "Block Scripts and Embeds Until Consent Switch"
msgstr "Interruttore Blocca script e incorporamenti fino al consenso"

#: build/admin.js:77
msgid "Block Scripts Until Consent"
msgstr "Blocca script fino al consenso"

#: build/admin.js:77
msgid "Prevent non-essential scripts and embeds from loading until users give consent."
msgstr "Impedisci il caricamento di script e incorporamenti non essenziali finché gli utenti non danno il consenso."

#: build/admin.js:77
msgid "Detected and Managed Resources"
msgstr "Risorse Rilevate e Gestite"

#. translators: 1: scanner-detected count, 2: custom rule count
#: build/admin.js:78
#, js-format
msgid "%1$d detected by scanner, %2$d custom"
msgstr "%1$d rilevate dallo scanner, %2$d personalizzate"

#: build/admin.js:78
msgid "New Resource"
msgstr "Nuova Risorsa"

#: build/admin.js:78
msgid "All your scripts will be displayed here"
msgstr "Tutti i tuoi script saranno visualizzati qui"

#: build/admin.js:78
msgid "Run a scan to detect third-party resources, or add a script manually."
msgstr "Esegui una scansione per rilevare risorse di terze parti o aggiungi uno script manualmente."

#: build/admin.js:78
msgid "Add New Resource"
msgstr "Aggiungi Nuova Risorsa"

#: build/admin.js:78
msgid "Unlock Custom Script Rules & Whitelisting"
msgstr "Sblocca Regole Script Personalizzate e Lista Bianca"

#: build/admin.js:78
msgid "Add your own scripts to block under any category, whitelist trusted scripts, and manage it all from one place."
msgstr "Aggiungi i tuoi script da bloccare in qualsiasi categoria, inserisci nella lista bianca gli script affidabili e gestisci tutto da un unico posto."

#: build/admin.js:78
msgid "Generate your cookie policy automatically from your settings, or display it anywhere using a shortcode."
msgstr "Genera automaticamente la tua politica sui cookie dalle impostazioni o visualizzala ovunque usando uno shortcode."

#: build/admin.js:78
msgid "Automatically re-scan your site and get notified when new cookies or trackers appear."
msgstr "Riscansiona automaticamente il tuo sito e ricevi notifiche quando appaiono nuovi cookie o tracker."

#: build/admin.js:84
msgid "Show your cookie banner only in regions where consent is required."
msgstr "Mostra il banner dei cookie solo nelle regioni dove è richiesto il consenso."

#: build/admin.js:84
msgid "Share visitor consent across your sites so users don’t need to give consent again."
msgstr "Condividi il consenso dei visitatori tra i tuoi siti così gli utenti non devono dare nuovamente il consenso."

#: build/admin.js:84
msgid "Unlock Consent Sharing"
msgstr "Sblocca la Condivisione del Consenso"

#: build/admin.js:77
msgid "Allowed to load while Google Consent Mode is active, instead of being blocked before consent."
msgstr "Consentito il caricamento mentre la Modalità di Consenso Google è attiva, invece di essere bloccato prima del consenso."

#: build/admin.js:77
msgid "These Google services are allowed to load while Google Consent Mode is active, instead of being blocked before consent. For Google tag products, Consent Mode then controls what they may store and which identifiers they may use. It does not stop them from contacting Google. They cannot be removed here."
msgstr "Questi servizi Google sono autorizzati a caricarsi mentre la Modalità di Consenso Google è attiva, invece di essere bloccati prima del consenso. Per i prodotti Google tag, la Modalità di Consenso controlla quindi cosa possono memorizzare e quali identificatori possono utilizzare. Non impedisce loro di contattare Google. Non possono essere rimossi da qui."
