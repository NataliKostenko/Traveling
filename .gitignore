# Secrets - never commit
.env
.envrc

# Database dump - contains emails, password hashes, IP addresses
db-templates/clean_local.sql
sql/

# Local by Flywheel service files
conf/
logs/

# wp-config.php and .htaccess are generated automatically by the container at build/first run
public/wp-config.php
public/.htaccess

# Cache and logs
public/wp-content/cache/
public/wp-content/*.log

# Vendor/build folders - regenerated by composer/npm, not needed in repo
public/wp-content/plugins/*/vendor/
public/wp-content/plugins/*/build/vendor/
public/wp-includes/js/dist/vendor/

# System files
.DS_Store
Thumbs.db
